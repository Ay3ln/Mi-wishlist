rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "ayelencononir@gmail.com";
    }

    function statusPath(guideId, itemKey) {
      return /databases/$(database)/documents/wishlistReservationStatus/$(guideId)/items/$(itemKey);
    }

    function detailsPath(guideId, itemKey) {
      return /databases/$(database)/documents/wishlistReservations/$(guideId)/items/$(itemKey);
    }

    match /wishlistGuides/{guideId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /wishlistReservationStatus/{guideId}/items/{itemKey} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null
        && request.resource.data.keys().hasAll(["reserved"])
        && request.resource.data.keys().hasOnly(["reserved"])
        && request.resource.data.reserved == true
        && existsAfter(detailsPath(guideId, itemKey))
        && getAfter(detailsPath(guideId, itemKey)).data.uid == request.auth.uid
      );
      allow update: if false;
      allow delete: if isAdmin() || (
        request.auth != null
        && exists(detailsPath(guideId, itemKey))
        && get(detailsPath(guideId, itemKey)).data.uid == request.auth.uid
        && !existsAfter(detailsPath(guideId, itemKey))
      );
    }

    match /wishlistReservations/{guideId}/items/{itemKey} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() || (
        request.auth != null
        && request.resource.data.keys().hasAll(["uid", "name", "createdAt"])
        && request.resource.data.keys().hasOnly(["uid", "name", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.createdAt == request.time
        && getAfter(statusPath(guideId, itemKey)).data.reserved == true
      );
      allow update: if false;
      allow delete: if isAdmin() || (
        request.auth != null
        && resource.data.uid == request.auth.uid
        && !existsAfter(statusPath(guideId, itemKey))
      );
    }

    match /wishlistReservations/{guideId} {
      allow read, write: if isAdmin();
    }
  }
}